rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'fullName', 'email', 'role', 'createdAt', 'updatedAt', 'phoneNumber']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 100 &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 25)) &&
        data.role is string && (data.role == 'Patient' || data.role == 'Doctor') &&
        data.createdAt is timestamp;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'sainathas8788@gmail.com';
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'sainathas8788@gmail.com');

      match /{allChildren=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'sainathas8788@gmail.com');
      }
    }

    match /telemetry/{telemetryId} {
      allow read, write: if request.auth != null && (request.auth.uid == telemetryId || request.auth.token.email == 'sainathas8788@gmail.com');
    }
  }
}
