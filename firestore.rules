rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'sainathas8788@gmail.com';
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'sainathas8788@gmail.com');

      match /{allChildren=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'sainathas8788@gmail.com');
      }
    }

    match /telemetry/{telemetryId} {
      allow read, write: if request.auth != null;
    }

    match /vitals/{document} {
      allow read, write: if request.auth != null;
    }

    match /appointments/{document} {
      allow read, write: if request.auth != null;
    }

    match /medical_records/{document} {
      allow read, write: if request.auth != null;
    }

    match /clinical_records/{document} {
      allow read, write: if request.auth != null;
    }

    match /prescriptions/{document} {
      allow read, write: if request.auth != null;
    }

    match /medicalRecords/{document} {
      allow read, write: if request.auth != null;
    }

    match /consultation_messages/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
